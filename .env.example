# Beispiel-Konfiguration für ein Projekt von backup_full_db_files_zip.sh
#
# Diese Datei dient nur als Referenz. Das Skript unterstützt beliebig viele
# Projekte im selben Ordner: jedes Projekt bekommt eine eigene Datei nach dem
# Muster .env.<projektname> (z.B. .env.kundeA, .env.kundeB, ...). Existiert für
# ein Projekt noch keine solche Datei, startet automatisch ein interaktiver
# Setup-Assistent, der dich nach diesen Werten fragt und daraus die echte
# .env.<projektname>-Datei anlegt (chmod 600). Diese Beispieldatei musst du
# normalerweise nicht von Hand kopieren oder ausfüllen.

PROJECT_NAME='beispielprojekt'
PROJEKT_BASIS_DATEINAME='backup'

# Was beim Aufruf ohne --scope-Parameter standardmäßig gesichert werden soll: alles / db / dateien
DEFAULT_SCOPE='alles'

# Beliebig viele Datenbanken via DB_COUNT und DB_<n>_HOST/NAME/USER/PASSWORD
DB_COUNT='2'
DB_1_HOST='localhost'
DB_1_NAME='my_db_name'
DB_1_USER='my_db_user'
DB_1_PASSWORD='myVerySecurePassword'
DB_2_HOST='localhost'
DB_2_NAME='my_second_db_name'
DB_2_USER='my_second_db_user'
DB_2_PASSWORD='myOtherVerySecurePassword'
# Weitere Datenbanken: DB_COUNT erhöhen und DB_3_*, DB_4_*, ... ergänzen

SOURCE_FILES_DIR='/pfad/zum/website/root/'
# Auszuschließende Muster als Bash-Array - je Element genau ein Muster.
# So bleiben die Muster auch mit Sonderzeichen/Leerzeichen zuverlässig erhalten.
# Empfohlen für WordPress: Cache, Upload-Caches, Backup-Plugins, Logs, .git, .DS_Store
SOURCE_FILES_DIR_IGNORE=('*/wp-content/cache/*' '*/wp-content/uploads/cache/*' '*/wp-content/updraft/*' '*/wp-content/backups/*' '*/wp-content/ai1wm-backups/*' '*/wp-content/uploads/wp-clone/*' '*/wp-content/uploads/backupbuddy_backups/*' '*/wp-content/uploads/snapshots/*' '*/wp-content/wflogs/*' '*/wp-content/debug.log' '*/error_log' '*/*.log' '*/.git/*' '*/.svn/*' '*/node_modules/*' '*/.DS_Store' '*/Thumbs.db')

SFTP_HOST=''
SFTP_PORT='22'
SFTP_KEY='/.ssh/id_rsa_backup'
SFTP_USER='sftpuser'
SFTP_DIRECTORY=''
SFTP_PATH_TO_SSH_BINARY='/usr/bin/ssh'

RSYNC_HOST=''
RSYNC_USER=''
RSYNC_DIRECTORY=''
RSYNC_KEY='/.ssh/id_rsa_backup'

BACKUP_LIVE_TIME='0'
DELETE_IF_TRANSMITTED='false'

STATUS_EMAIL_ADDRESS=''
ALERT_EMAIL_ADDRESS=''
