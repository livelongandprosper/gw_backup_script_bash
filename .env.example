# Beispiel-Konfiguration für backup_full_db_files_zip.sh
#
# Diese Datei dient nur als Referenz. Beim ersten Start des Skripts wird,
# falls keine .env-Datei existiert, automatisch ein Setup-Assistent gestartet,
# der dich interaktiv nach diesen Werten fragt und daraus eine echte .env-Datei
# anlegt (chmod 600). Diese Beispieldatei musst du normalerweise nicht von
# Hand kopieren oder ausfüllen.

PROJEKT_BASIS_DATEINAME='backup'

# Beliebig viele Datenbanken via DB_COUNT und DB_<n>_HOST/NAME/USER/PASSWORD
DB_COUNT='2'
DB_1_HOST='localhost'
DB_1_NAME='my_db_name'
DB_1_USER='my_db_user'
DB_1_PASSWORD='myVerySecurePassword'
DB_2_HOST='localhost'
DB_2_NAME='my_second_db_name'
DB_2_USER='my_second_db_user'
DB_2_PASSWORD='myOtherVerySecurePassword'
# Weitere Datenbanken: DB_COUNT erhöhen und DB_3_*, DB_4_*, ... ergänzen

SOURCE_FILES_DIR='/pfad/zum/website/root/'
SOURCE_FILES_DIR_IGNORE='*/media/* */cache/*'

SFTP_HOST=''
SFTP_PORT='22'
SFTP_KEY='/.ssh/id_rsa_backup'
SFTP_USER='sftpuser'
SFTP_DIRECTORY=''
SFTP_PATH_TO_SSH_BINARY='/usr/bin/ssh'

RSYNC_HOST=''
RSYNC_USER=''
RSYNC_DIRECTORY=''
RSYNC_KEY='/.ssh/id_rsa_backup'

BACKUP_LIVE_TIME='0'
DELETE_IF_TRANSMITTED='false'

STATUS_EMAIL_ADDRESS=''
ALERT_EMAIL_ADDRESS=''
